package cleat;

// An Int that changes in one step (section 13.4).
public final class AtomicInt {
    Int value;

    public AtomicInt(Int initial) {
        this.value = initial;
    }

    @Intrinsic
    public Int get();

    @Intrinsic
    public void set(Int value);

    @Intrinsic
    public Boolean compareAndSet(Int expected, Int update);

    // The sum is worked out before the cell changes, so a sum that is not an Int
    // raises and leaves the cell as it was.
    @Discardable
    public Int addAndGet(Int delta) {
        while (true) {
            var current = get();
            var sum = current + delta;
            if (compareAndSet(current, sum)) {
                return sum;
            }
        }
    }

    @Discardable
    public Int incrementAndGet() {
        return addAndGet(1);
    }
}
