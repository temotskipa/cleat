package cleat;

// A mirror of one method that carries an annotation (section 8.9).
public value class Method {
    Class owner;
    Int index;

    package Method {
    }

    public String getName() {
        return owner.methodName(index);
    }

    public Boolean isStatic() {
        return owner.methodIsStatic(index);
    }

    public Parameter[] getParameters() {
        return Array.<Parameter>build(owner.parameterCount(index), (i) -> new Parameter(owner, index, i));
    }

    public <A extends Annotation> A? getAnnotation() {
        return owner.<A>methodAnnotation(index);
    }

    @Discardable
    public Object? invoke(Object? target, Object?... arguments) {
        return owner.methodInvoke(index, target, arguments);
    }
}
