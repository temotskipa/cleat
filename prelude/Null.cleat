package cleat;

// The class of `null`. It stands outside the hierarchy of Object, and no expression
// creates an instance of it.
public final value class Null {
    private Null {
    }

    // True only when `other` is null.
    public Boolean equals(@Nullable Object other) {
        return other == null;
    }

    // One unchanging Int.
    public Int hashCode() {
        return 0;
    }

    public String toString() {
        return "null";
    }
}
