package cleat;

// A mirror of one field that carries an annotation (section 8.9).
public value class Field {
    Class owner;
    Int index;

    package Field {
    }

    public String getName() {
        return owner.fieldName(index);
    }

    public Boolean isStatic() {
        return owner.fieldIsStatic(index);
    }

    public <A extends Annotation> A? getAnnotation() {
        return owner.<A>fieldAnnotation(index);
    }

    public Object? get(Object? target) {
        return owner.fieldGet(index, target);
    }

    public void set(Object? target, Object? value) {
        owner.fieldSet(index, target, value);
    }
}
