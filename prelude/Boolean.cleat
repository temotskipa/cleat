package cleat;

public value class Boolean {
    private Boolean {
    }

    // `a & b`. Both operands are evaluated before the method runs, which is what tells
    // it from `a && b`.
    public Boolean and(Boolean other) {
        return this ? other : false;
    }

    // `a | b`.
    public Boolean or(Boolean other) {
        return this ? true : other;
    }

    // `a ^ b`: true when exactly one of the two is.
    public Boolean xor(Boolean other) {
        return this ? other.not() : other;
    }

    // `!a`.
    public Boolean not() {
        return this ? false : true;
    }
}
