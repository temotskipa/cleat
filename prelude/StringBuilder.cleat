package cleat;

// Text that grows by appending.
public class StringBuilder {
    Char[] chars;
    Int count;

    public StringBuilder() {
        this.chars = new Char[16];
        this.count = 0;
    }

    public Int length() {
        return count;
    }

    public Boolean isEmpty() {
        return count == 0;
    }

    @Discardable
    public StringBuilder append(Char c) {
        if (count == chars.length()) {
            reserve(count * 2);
        }
        chars[count] = c;
        count++;
        return this;
    }

    // Appends `value.toString()`.
    @Discardable
    public StringBuilder append(@Nullable Object value) {
        String text = value.toString();
        Int length = text.length();
        if (count + length > chars.length()) {
            reserve((count + length) * 2);
        }
        for (var i = 0; i < length; i++) {
            chars[count + i] = text[i];
        }
        count += length;
        return this;
    }

    public void clear() {
        count = 0;
    }

    @Override
    public String toString() {
        return String.fromChars(chars, count);
    }

    void reserve(Int size) {
        Char[] larger = new Char[size];
        for (var i = 0; i < count; i++) {
            larger[i] = chars[i];
        }
        chars = larger;
    }
}
