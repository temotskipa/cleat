package cleat;

// A sequence of Unicode scalars.
public value class String implements Ordered<String>, Iterable<Char> {
    private String {
    }

    @Intrinsic
    public Int length();

    @Intrinsic
    public Char get(Int index);

    @Intrinsic
    public String substring(Int begin, Int end);

    // The scalars of this string and then those of `other`.
    @Intrinsic
    private String join(String other);

    // `text + x`: the text and then the `toString` of `x`, whatever `x` is.
    public String plus(@Nullable Object other) {
        return join(other.toString());
    }

    // Where `c` first stands, or -1.
    public Int indexOf(Char c) {
        for (var i = 0; i < length(); i++) {
            if (this[i] == c) {
                return i;
            }
        }
        return -1;
    }

    // Where `s` first begins, or -1.
    public Int indexOf(String s) {
        for (var start = 0; start + s.length() <= length(); start++) {
            if (matches(s, start)) {
                return start;
            }
        }
        return -1;
    }

    public Boolean startsWith(String s) {
        return s.length() <= length() && matches(s, 0);
    }

    public Boolean endsWith(String s) {
        return s.length() <= length() && matches(s, length() - s.length());
    }

    // Whether the scalars of `s` stand here from `start` on. The caller has seen that
    // they fit.
    private Boolean matches(String s, Int start) {
        for (var i = 0; i < s.length(); i++) {
            if (this[start + i] != s[i]) {
                return false;
            }
        }
        return true;
    }

    public Boolean isEmpty() {
        return length() == 0;
    }

    public Boolean contains(String s) {
        return indexOf(s) >= 0;
    }

    // The UTF-8 encoding, as a new array: one to four bytes for each scalar.
    public UInt8[] toUtf8() {
        var count = 0;
        for (var i = 0; i < length(); i++) {
            var code = this[i].code();
            count += code < 128 ? 1 : code < 2048 ? 2 : code < 65536 ? 3 : 4;
        }
        var bytes = new UInt8[count];
        var at = 0;
        for (var i = 0; i < length(); i++) {
            var code = this[i].code();
            if (code < 128) {
                bytes[at] = UInt8.from(code);
                at += 1;
            } else if (code < 2048) {
                bytes[at] = UInt8.from(192 + (code >> 6));
                bytes[at + 1] = UInt8.from(128 + (code & 63));
                at += 2;
            } else if (code < 65536) {
                bytes[at] = UInt8.from(224 + (code >> 12));
                bytes[at + 1] = UInt8.from(128 + ((code >> 6) & 63));
                bytes[at + 2] = UInt8.from(128 + (code & 63));
                at += 3;
            } else {
                bytes[at] = UInt8.from(240 + (code >> 18));
                bytes[at + 1] = UInt8.from(128 + ((code >> 12) & 63));
                bytes[at + 2] = UInt8.from(128 + ((code >> 6) & 63));
                bytes[at + 3] = UInt8.from(128 + (code & 63));
                at += 4;
            }
        }
        return bytes;
    }

    // The string these bytes encode. Bytes that are not well-formed UTF-8 raise.
    public static String fromUtf8(UInt8[] bytes) {
        var chars = new Char[bytes.length()];
        var count = 0;
        var at = 0;
        while (at < bytes.length()) {
            var first = Int.from(bytes[at]);
            // How many bytes follow the first. 192 and 193 could only begin a form that
            // is longer than it needs to be, and nothing begins above 244.
            var more = first < 128 ? 0 : first >= 194 && first < 224 ? 1 : first >= 224 && first < 240 ? 2 : first >= 240 && first < 245 ? 3 : -1;
            if (more < 0 || at + more >= bytes.length()) {
                throw malformed();
            }
            var code = more == 0 ? first : more == 1 ? first & 31 : more == 2 ? first & 15 : first & 7;
            for (var k = 1; k <= more; k++) {
                var next = Int.from(bytes[at + k]);
                if (next < 128 || next >= 192) {
                    throw malformed();
                }
                code = (code << 6) | (next & 63);
            }
            // The shortest form only, no surrogate, and nothing above U+10FFFF.
            if (more == 2 && code < 2048 || more == 3 && code < 65536 || code > 1114111 || code >= 55296 && code < 57344) {
                throw malformed();
            }
            chars[count] = Char.from(code);
            count += 1;
            at += more + 1;
        }
        return fromChars(chars, count);
    }

    private static IllegalArgumentException malformed() {
        return new IllegalArgumentException("the bytes are not well-formed UTF-8");
    }

    // The first `count` scalars of `chars`.
    @Intrinsic
    public static String fromChars(Char[] chars, Int count);

    // The full case mapping of Unicode, in which one scalar can become several. It
    // needs the tables of the host.
    @Intrinsic
    public String toLowerCase();

    @Intrinsic
    public String toUpperCase();

    // The string without the whitespace at either end.
    public String trim() {
        var begin = 0;
        var end = length();
        while (begin < end && this[begin].isWhitespace()) {
            begin++;
        }
        while (end > begin && this[end - 1].isWhitespace()) {
            end--;
        }
        return substring(begin, end);
    }

    // The pieces between occurrences of `separator`. An empty separator is rejected.
    public List<String> split(String separator) {
        if (separator.isEmpty()) {
            throw new IllegalArgumentException("the separator is empty");
        }
        var pieces = new List<String>();
        var rest = this;
        while (true) {
            var at = rest.indexOf(separator);
            if (at < 0) {
                pieces.add(rest);
                return pieces;
            }
            pieces.add(rest.substring(0, at));
            rest = rest.substring(at + separator.length(), rest.length());
        }
    }

    // The order of the first scalar that differs, and then of the lengths.
    @Override
    public Int compare(String other) {
        var shared = length() < other.length() ? length() : other.length();
        for (var i = 0; i < shared; i++) {
            var mine = this[i].code();
            var theirs = other[i].code();
            if (mine != theirs) {
                return mine < theirs ? -1 : 1;
            }
        }
        return length().compare(other.length());
    }

    @Override
    public Boolean lessThan(String other) {
        return compare(other) < 0;
    }

    @Override
    public Boolean atMost(String other) {
        return compare(other) <= 0;
    }

    @Override
    public Boolean greaterThan(String other) {
        return compare(other) > 0;
    }

    @Override
    public Boolean atLeast(String other) {
        return compare(other) >= 0;
    }

    @Override
    public Iterator<Char> iterator() {
        return new StringIterator(this);
    }
}

class StringIterator implements Iterator<Char> {
    final String text;
    Int index;

    public StringIterator(String text) {
        this.text = text;
        this.index = 0;
    }

    @Override
    public Boolean hasNext() {
        return index < text.length();
    }

    @Override
    public Char next() {
        Char c = text[index];
        index++;
        return c;
    }
}
