// A small gravitational simulation that prints total energy before and after.
// Exercises: Float64 arithmetic, literals typed by context, a user value class
// whose methods give it operators, an array of objects, indexed loops.
package demo;

value class Vec3 {
    public Float64 x;
    public Float64 y;
    public Float64 z;

    public Vec3 plus(Vec3 other) {
        return new Vec3(x + other.x, y + other.y, z + other.z);
    }

    public Vec3 minus(Vec3 other) {
        return new Vec3(x - other.x, y - other.y, z - other.z);
    }

    public Vec3 times(Float64 scale) {
        return new Vec3(x * scale, y * scale, z * scale);
    }

    public Float64 dot(Vec3 other) {
        return x * other.x + y * other.y + z * other.z;
    }
}

class Body {
    public Vec3 position;
    public Vec3 velocity;
    public final Float64 mass;

    public Body(Vec3 position, Vec3 velocity, Float64 mass) {
        this.position = position;
        this.velocity = velocity;
        this.mass = mass;
    }
}

public class NBody {
    public static void main(String[] args) {
        // Integer literals in a Float64 position are Float64.
        Body[] bodies = new Body[] {
            new Body(new Vec3(0, 0, 0), new Vec3(0, 0, 0), 1000),
            new Body(new Vec3(10, 0, 0), new Vec3(0, 10, 0), 1),
            new Body(new Vec3(-20, 0, 0), new Vec3(0, -7, 0), 1)
        };

        Console.println("energy before: " + energy(bodies).toFixed(6));
        Float64 dt = 0.001;
        for (var step = 0; step < 10000; step++) {
            advance(bodies, dt);
        }
        Console.println("energy after:  " + energy(bodies).toFixed(6));
    }

    static void advance(Body[] bodies, Float64 dt) {
        for (var i = 0; i < bodies.length(); i++) {
            for (var j = i + 1; j < bodies.length(); j++) {
                Body a = bodies[i];
                Body b = bodies[j];
                Vec3 delta = a.position - b.position;
                Float64 distance = delta.dot(delta).sqrt();
                Float64 pull = dt / (distance * distance * distance);
                a.velocity -= delta * (b.mass * pull);
                b.velocity += delta * (a.mass * pull);
            }
        }
        for (Body body : bodies) {
            body.position += body.velocity * dt;
        }
    }

    static Float64 energy(Body[] bodies) {
        Float64 total = 0;
        for (var i = 0; i < bodies.length(); i++) {
            Body a = bodies[i];
            // 0.5 takes Float64 from the other operand.
            total += 0.5 * a.mass * a.velocity.dot(a.velocity);
            for (var j = i + 1; j < bodies.length(); j++) {
                Body b = bodies[j];
                Vec3 delta = a.position - b.position;
                total -= a.mass * b.mass / delta.dot(delta).sqrt();
            }
        }
        return total;
    }
}
