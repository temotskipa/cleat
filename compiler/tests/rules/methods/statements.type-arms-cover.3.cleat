//@ rule: methods.statements.type-arms-cover
//@ rejected: a switch expression is exhaustive: add the missing arms or a `default` arm
sealed interface Shape permits Circle, Square { } value class Circle implements Shape { public Int r; } value class Square implements Shape { public Int side; } class A { Int f(Shape s) { return switch (s) { case Circle c when c.r > 0 -> 1; case Square q -> 2; }; } }
