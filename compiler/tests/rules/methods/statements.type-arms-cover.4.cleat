//@ rule: methods.statements.type-arms-cover
//@ accepted
sealed interface Shape permits Circle, Square { } value class Circle implements Shape { public Int r; } value class Square implements Shape { public Int side; } class A { Int f(Shape s) { return switch (s) { case Circle c when c.r > 0 -> 1; case Circle c -> 0; case Square q -> 2; }; } }
