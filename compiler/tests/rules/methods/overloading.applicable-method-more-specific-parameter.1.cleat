//@ rule: methods.overloading.applicable-method-more-specific-parameter
//@ rejected: is ambiguous: 2 methods accept these arguments and none is more specific than the rest
open class Shape { } class Circle extends Shape { } class Square extends Shape { } class A { static Int f(Shape a, Object b) { return 1; } static Int f(Object a, Shape b) { return 2; } Int g(Circle c) { return f(c, c); } }
