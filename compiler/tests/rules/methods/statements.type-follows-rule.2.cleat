//@ rule: methods.statements.type-follows-rule
//@ accepted
open class Shape { } class Circle extends Shape { } class Square extends Shape { } class A { Float64 f(Int n) { Float64 x = switch (n) { case 1 -> 1; default -> 0.5; }; var s = switch (n) { case 1 -> new Shape(); default -> new Circle(); }; Shape t = s; return x; } }
