//@ rule: visibility.overriding.method-overridden-only
//@ rejected: `f` carries `@Override` and overrides nothing
//@ file: a/A.cleat
package a; public open class A { package open Int f() { return 1; } }
//@ file: b/B.cleat
package b; import a.A; public class B extends A { @Override public Int f() { return 2; } }
