//@ rule: flow.reachability.switch-statement-arm
//@ accepted
class A { void g() { } Int f(Int n) { switch (n) { case 1 -> { return 1; } } g(); switch (n) { case 2 -> { return 1; } default -> { } } g(); switch (n) { case 3 -> { return 1; } default -> { if (n > 5) { break; } return 2; } } return 3; } }
