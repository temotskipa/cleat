//@ rule: flow.narrowing.call-narrows-class
//@ rejected: `Int` is not assignable to `@Positive Int`
@Refines annotation Positive; class Counts { @Narrows(Positive.class) public static Boolean isPositive(Int n) { return n > 0; } } class A { static Int need(@Positive Int n) { return n; } static Int f(Int n) { if (Counts.isPositive(n)) { return 0; } else { return need(n); } } }
