//@ rule: flow.narrowing.while-for-statement
//@ accepted
class A { String? g() { return null; } Int f(String? s) { while (s == null) { s = g(); } return s.length(); } Int h(String? s) { var n = 0; while (s != null) { n += s.length(); s = g(); } for (var t = g(); t != null; t = g()) { n += t.length(); } return n; } }
