//@ rule: generics.variance.in-parameter-subtype
//@ rejected: `Snk<Circle>` is not assignable to `Snk<Shape>`
open class Shape { } class Circle extends Shape { } interface Snk<in T> { void put(T x); } class Bin<T> implements Snk<T> { @Override public void put(T x) { } } class A { Snk<Shape> f(Snk<Circle> x) { return x; } }
