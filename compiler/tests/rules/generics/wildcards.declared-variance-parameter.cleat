//@ rule: generics.wildcards.declared-variance-parameter
//@ accepted
open class Shape { } class Circle extends Shape { } interface Snk<in T> { void put(T x); } class Bin<T> implements Snk<T> { @Override public void put(T x) { } } class A { Iterable<Shape> f(Iterable<? extends Shape> x) { return x; } Iterable<? extends Shape> g(Iterable<Shape> x) { return x; } Snk<Circle> h(Snk<? super Circle> x) { return x; } List<Snk<? super Circle>> i(List<Snk<Circle>> x) { return x; } }
