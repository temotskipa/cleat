//@ rule: generics.wildcards.argument-in-parameter
//@ accepted
open class Shape { } class Circle extends Shape { } interface Snk<in T> { void put(T x); } class Bin<T> implements Snk<T> { @Override public void put(T x) { } } class Box<T> { public Snk<T> sink() { return new Bin<T>(); } } class A { Snk<Circle> f(Box<? super Circle> b) { return b.sink(); } Snk<?> g(Box<? extends Shape> b) { return b.sink(); } }
