//@ rule: annotations.declaration.method-declared-value
//@ rejected: an `@Implicit` method is a static method of a value class `T` with one parameter of another value class, the result `T`, and no type parameters
class Wrap { public Int n; public Wrap(Int n) { this.n = n; } @Implicit public static Wrap from(Int whole) { return new Wrap(whole); } }
