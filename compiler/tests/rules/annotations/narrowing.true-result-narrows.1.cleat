//@ rule: annotations.narrowing.true-result-narrows
//@ rejected: `Int` is not assignable to `@Positive Int`
@Refines annotation Positive; class Counts { @Narrows(Positive.class) public static Boolean isPositive(Int n) { return n > 0; } static Int need(@Positive Int n) { return n; } static Int f(Int n) { if (!isPositive(n)) { return need(n); } return 0; } }
