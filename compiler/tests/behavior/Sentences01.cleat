// Chapter 1 at run time: what the escapes and the text blocks of section 1.3 denote.
// A line `//@ rule:` names the rule that the next statement shows.
package t;

public class Sentences01 {
    public static void main() {
        //@ rule: source.tokens.newline-tab-return
        Console.println("escapes: " + '\n'.code() + " " + '\t'.code() + " " + '\r'.code());
        //@ rule: source.tokens.character-after-backslash
        Console.println("after the backslash: " + '\\'.code() + " " + '\"'.code() + " " + '\''.code());
        //@ rule: source.tokens.four-hexadecimal-digits
        Console.println("four digits: " + 'é'.code() + " " + "A");
        //@ rule: source.tokens.six-hexadecimal-digits
        Console.println("braces: " + '\u{1F600}'.code() + " " + '\u{41}'.code());

        String block = """
            first
              second
            """;
        //@ rule: source.tokens.text-block-string
        Console.println("text block: " + block.contains("first") + " " + block.contains("second"));
        //@ rule: source.tokens.whitespace-before-closing
        Console.println("indent: " + block.equals("first\n  second"));
        //@ rule: source.tokens.line-break-content
        Console.println("line breaks: " + block.length() + " " + block.toUtf8()[5]);

        String tabbed = """
            \tx
            """;
        //@ rule: source.tokens.escapes-apply-after
        Console.println("escaped block: " + tabbed.equals("\tx"));

        String word = "cat";
        Int count = 2;
        //@ rule: source.tokens.embedded-expression-begins
        //@ rule: source.tokens.embedded-read-tokens
        Console.println("embedded: \{word} \{ "[" + word + "]" } \{ count > 1 ? "{" : "}" } \{ '}' }");
        String listed = """
            \{word}
              \{count + 1}
            """;
        //@ rule: source.tokens.embedded-ends-line
        Console.println("embedded in a block: " + listed.equals("cat\n  3"));
    }
}
