// Chapter 5 at run time. A line `//@ rule:` names the rule that the next statement
// shows.
package t;

class Holder {
    public String? text;
}

value class Point {
    public Int x;
}

class Caster<T> {
    public T cast(Object? o) {
        return (T) o;
    }
}

public class Sentences05 {
    static String? loud(String what) {
        Console.println("  evaluated " + what);
        return what;
    }

    static void nothing() {
    }

    static Unit alsoNothing() {
        return;
    }

    public static void main() {
        Object? none = null;
        String? some = "some";
        String? missing = null;
        Int n = 5;

        //@ rule: null.nullable.nullable-field-no
        Console.println("nullable field: " + (new Holder().text == null));
        //@ rule: null.sends.open-null-declares
        //@ rule: null.sends.receiver-null-method
        Console.println("Null methods: " + none.toString() + " " + none.hashCode() + " " + none.equals(null) + " " + none.equals("x"));
        //@ rule: null.sends.override-equals-returns
        Console.println("equals null: " + "s".equals(null) + " " + n.equals(null) + " " + new Point(1).equals(null) + " " + new Holder().equals(null));

        //@ rule: null.tests.value-not-null
        Console.println("coalesce, left is not null:");
        var kept = some ?? loud("the right operand");
        Console.println("coalesce, left is null:");
        var taken = missing ?? loud("the right operand");
        //@ rule: null.tests.coalesce-evaluates
        //@ rule: null.tests.otherwise-result-value
        Console.println("coalesce: " + kept + " " + taken);

        Boolean? no = false;
        //@ rule: null.tests.coalesce-binds-more
        Console.println("precedence: " + (missing ?? missing ?? "c") + " " + (no ?? true || true) + " " + ((true ? missing : some ?? "z") == null));

        Object text = "text";
        //@ rule: null.casts.cast-class-test
        try {
            var s = (String) text;
            var i = (Int) text;
            Console.println("casts: " + s + " " + i);
        } catch (ClassCastException e) {
            Console.println("casts: a String is not an Int");
        }
        //@ rule: null.casts.raises-classcastexception-value
        try {
            var s = (String) none;
            Console.println("cast of null: " + s);
        } catch (ClassCastException e) {
            Console.println("cast of null: raises");
        }
        //@ rule: null.casts.nullable-accepts-null
        Console.println("nullable cast: " + ((String?) none == null));
        //@ rule: null.casts.null-instanceof-false
        Console.println("instanceof null: " + (none instanceof String) + " " + (none instanceof Object));

        Object plain = new List<String>();
        Object nullable = new List<String?>();
        //@ rule: null.type-arguments.nullability-type-argument
        //@ rule: null.type-arguments.list-string-nullable
        Console.println("type arguments: " + (plain instanceof List<String>) + " " + (plain instanceof List<String?>) + " " + (nullable instanceof List<String?>) + " " + (plain.getClass() == nullable.getClass()) + " " + nullable.getClass().getName());

        //@ rule: null.type-arguments.inside-generic-code
        //@ rule: null.type-arguments.argument-string-null
        try {
            var s = new Caster<String>().cast(null);
            Console.println("generic cast to String: " + s);
        } catch (ClassCastException e) {
            Console.println("generic cast to String: raises");
        }
        //@ rule: null.type-arguments.argument-nullable-string
        Console.println("generic cast to String?: " + (new Caster<String?>().cast(null) == null));

        Unit a = nothing();
        Unit b = alsoNothing();
        //@ rule: null.unit.unit-final-value
        //@ rule: null.unit.returns-unit-instance
        Console.println("Unit: " + a.identical(b) + " " + a.getClass().getName());
    }
}
