// Chapter 13 at run time. A line `//@ rule:` names the rule that the next statement
// shows. Every wait here is for something that is certain to happen, so the output
// does not depend on how threads are scheduled.
package t;

// Opened once, and then every thread that waits at it goes on.
class Gate {
    final Lock lock = new Lock();
    final Condition opened = lock.newCondition();
    Boolean isOpen = false;
    public final AtomicInt waiting = new AtomicInt(0);

    public void release() {
        lock.exclusive(() -> {
            isOpen = true;
            opened.signalAll();
        });
    }

    public void pass() {
        lock.exclusive(() -> {
            waiting.incrementAndGet();
            while (!isOpen) {
                opened.await();
            }
        });
    }
}

// One value handed from a thread to another, with `signal`.
class Slot {
    final Lock lock = new Lock();
    final Condition filled = lock.newCondition();
    String? value;
    public final AtomicInt waiting = new AtomicInt(0);

    public void put(String text) {
        lock.exclusive(() -> {
            value = text;
            filled.signal();
        });
    }

    public String take() {
        return lock.exclusive(() -> {
            waiting.set(1);
            while (value == null) {
                filled.await();
            }
            return (String) value;
        });
    }
}

class Counter {
    public Int n = 0;
}

class Late {
    public static Int value = Sentences13.seven();
}

class Same {
    @Override
    public Boolean equals(Object? other) {
        return true;
    }

    @Override
    public Int hashCode() {
        return 0;
    }
}

value class Pt {
    public Int x;
}

public class Sentences13 {
    public static Int seven() {
        return 7;
    }

    // Spins until the cell is set. It reaches no point that checks for cancellation.
    static void until(AtomicInt cell) {
        while (cell.get() == 0) {
        }
    }

    // What a cancelled task sees when it does `action`.
    static String point(Function0<Unit> action) {
        return Scope.call((scope) -> {
            var task = scope.fork(() -> {
                while (!scope.isCancelled()) {
                }
                try {
                    action.invoke();
                    return "returned";
                } catch (CancellationException e) {
                    return "raised";
                }
            });
            scope.cancel();
            return task.result();
        });
    }

    public static void main() {
        var zero = new AtomicInt(0);
        var mainThread = Thread.current();

        // ---- 13.1 ----
        var box = new AtomicInt(0);
        var seen = new Atomic<Thread?>(null);
        var worker = Thread.start(() -> {
            seen.set(Thread.current());
            box.set(7);
        });
        worker.join();
        //@ rule: concurrency.threads.program-starts-thread
        //@ rule: concurrency.threads.thread-current-returns
        //@ rule: concurrency.threads.thread-runs-body
        //@ rule: concurrency.threads.threads-share-object
        Console.println("thread: " + box.get() + " " + (seen.get() == worker) + " " + (seen.get() == mainThread) + " " + worker.isAlive() + " " + (worker.uncaught() == null));

        //@ rule: concurrency.threads.negative-argument-raises
        try {
            Thread.sleep(-1);
            Console.println("sleep: returned");
        } catch (IllegalArgumentException e) {
            Console.println("sleep: a negative time raises");
        }
        //@ rule: concurrency.threads.joining-running-thread
        try {
            Thread.current().join();
            Console.println("join: returned");
        } catch (IllegalStateException e) {
            Console.println("join: joining the running thread raises");
        }

        var gate = new Gate();
        var held = Thread.start(() -> {
            gate.pass();
        });
        //@ rule: concurrency.threads.thread-start-creates
        //@ rule: concurrency.threads.uncaught-returns-null
        //@ rule: concurrency.threads.isalive-true-start
        Console.println("alive: " + held.isAlive() + " " + (held.uncaught() == null));
        gate.release();
        held.join();
        //@ rule: concurrency.threads.join-waits-until
        Console.println("after join: " + held.isAlive());

        var failed = Thread.start(() -> {
            if (zero.get() == 0) {
                throw new IllegalStateException("the body failed");
            }
        });
        failed.join();
        Throwable? why = failed.uncaught();
        //@ rule: concurrency.threads.exception-leaves-body
        Console.println("uncaught: " + (why == null ? "none" : why.message()) + ", and main goes on");

        // ---- 13.2 ----
        var lock = new Lock();
        var counted = new Counter();
        var cell = new AtomicInt(0);
        var workers = new List<Thread>();
        for (var t = 0; t < 4; t++) {
            workers.add(Thread.start(() -> {
                for (var i = 0; i < 1000; i++) {
                    lock.lock();
                    counted.n = counted.n + 1;
                    lock.unlock();
                    cell.incrementAndGet();
                }
            }));
        }
        for (Thread w : workers) {
            w.join();
        }
        //@ rule: concurrency.memory.thread-releases-lock
        //@ rule: concurrency.locks.lock-held-most
        //@ rule: concurrency.locks.lock-waits-until
        Console.println("lock: " + counted.n);
        //@ rule: concurrency.memory.operation-atomic-cell
        //@ rule: concurrency.atomics.method-step-no
        Console.println("atomic steps: " + cell.get());

        var before = new Counter();
        before.n = 5;
        var after = new Counter();
        var reader = Thread.start(() -> {
            after.n = before.n + 1;
        });
        reader.join();
        //@ rule: concurrency.memory.read-ordered-after
        //@ rule: concurrency.memory.thread-start-scope
        //@ rule: concurrency.memory.last-action-thread
        Console.println("start and join: " + after.n);

        var got = new AtomicInt(0);
        var first = Thread.start(() -> {
            got.set(Late.value);
        });
        first.join();
        //@ rule: concurrency.memory.end-class-initialization
        Console.println("class: " + got.get() + " " + Late.value);

        // ---- 13.3 ----
        var again = new Lock();
        again.lock();
        again.lock();
        again.unlock();
        again.unlock();
        //@ rule: concurrency.locks.thread-holds-call
        try {
            again.unlock();
            Console.println("reentrant: a third unlock returned");
        } catch (IllegalStateException e) {
            Console.println("reentrant: locked twice, unlocked twice, and then not held");
        }

        Int answer = again.exclusive(() -> 42);
        try {
            again.exclusive(() -> {
                if (zero.get() == 0) {
                    throw new IllegalArgumentException("in the body");
                }
            });
        } catch (IllegalArgumentException e) {
        }
        var free = new AtomicInt(0);
        var taker = Thread.start(() -> {
            again.lock();
            free.set(1);
            again.unlock();
        });
        taker.join();
        //@ rule: concurrency.locks.exclusive-calls-lock
        //@ rule: concurrency.locks.returns-body-result
        Console.println("exclusive: " + answer + " " + free.get());

        var condition = again.newCondition();
        var raised = 0;
        try {
            condition.await();
        } catch (IllegalStateException e) {
            raised += 1;
        }
        try {
            condition.signal();
        } catch (IllegalStateException e) {
            raised += 1;
        }
        try {
            condition.signalAll();
        } catch (IllegalStateException e) {
            raised += 1;
        }
        //@ rule: concurrency.locks.waiting-condition-belongs
        //@ rule: concurrency.locks.three-methods-raises
        Console.println("condition without its lock: " + raised);

        var slot = new Slot();
        var length = new AtomicInt(0);
        var receiver = Thread.start(() -> {
            length.set(slot.take().length());
        });
        until(slot.waiting);
        slot.put("ping");
        receiver.join();
        //@ rule: concurrency.locks.await-releases-lock
        //@ rule: concurrency.locks.signal-lets-waiting
        Console.println("signal: " + length.get());

        var crowd = new Gate();
        var through = new AtomicInt(0);
        var waiters = new List<Thread>();
        for (var t = 0; t < 3; t++) {
            waiters.add(Thread.start(() -> {
                crowd.pass();
                through.incrementAndGet();
            }));
        }
        while (crowd.waiting.get() < 3) {
        }
        crowd.release();
        for (Thread w : waiters) {
            w.join();
        }
        //@ rule: concurrency.locks.signalall-lets-waiting
        Console.println("signalAll: " + through.get());

        // ---- 13.4 ----
        var a = new AtomicInt(5);
        //@ rule: concurrency.atomics.atomic-cell-holds
        //@ rule: concurrency.atomics.compareandset-stores-update
        //@ rule: concurrency.atomics.atomicint-compares-equals
        //@ rule: concurrency.atomics.addandget-adds-delta
        //@ rule: concurrency.atomics.incrementandget-addandget
        Console.println("atomic int: " + a.get() + " " + a.compareAndSet(5, 6) + " " + a.compareAndSet(5, 7) + " " + a.get() + " " + a.addAndGet(10) + " " + a.incrementAndGet());
        var top = new AtomicInt(9223372036854775807);
        //@ rule: concurrency.atomics.sum-not-int
        try {
            top.addAndGet(1);
            Console.println("overflow: returned");
        } catch (ArithmeticException e) {
            Console.println("overflow: raises, and the cell is unchanged " + (top.get() == 9223372036854775807));
        }
        var one = new Same();
        var two = new Same();
        var references = new Atomic<Same>(one);
        var values = new Atomic<Pt>(new Pt(1));
        //@ rule: concurrency.atomics.atomic-compares-identical
        Console.println("atomic cell: " + references.compareAndSet(two, two) + " " + references.compareAndSet(one, two) + " " + references.get().identical(two) + " " + values.compareAndSet(new Pt(1), new Pt(2)) + " " + values.get().x);

        // ---- 13.5 ----
        var tasks = new List<Task<Int>>();
        Int sum = Scope.call((scope) -> {
            var onMain = Thread.current() == mainThread;
            for (var k = 1; k <= 3; k++) {
                var n = k;
                tasks.add(scope.fork(() -> {
                    Thread.sleep(5);
                    return n * n;
                }));
            }
            return onMain ? tasks[0].result() + tasks[1].result() : -1;
        });
        var done = 0;
        for (Task<Int> t : tasks) {
            if (t.isDone()) {
                done += 1;
            }
        }
        //@ rule: concurrency.threads.program-needs-threads
        //@ rule: concurrency.scopes.scope-starts-tasks
        //@ rule: concurrency.scopes.no-task-outlives
        //@ rule: concurrency.scopes.scope-call-creates
        //@ rule: concurrency.scopes.otherwise-call-returns
        Console.println("scope: " + sum + " " + done);

        var door = new Gate();
        var where = new Atomic<Thread?>(null);
        var order = Scope.call((scope) -> {
            var task = scope.fork(() -> {
                where.set(Thread.current());
                door.pass();
                return 1;
            });
            var early = task.isDone();
            door.release();
            return (early ? "after" : "before") + " the task ended, result " + task.result() + ", done " + task.isDone();
        });
        //@ rule: concurrency.scopes.fork-starts-task
        //@ rule: concurrency.scopes.returns-once-thread
        //@ rule: concurrency.scopes.result-waits-until
        Console.println("fork: returned " + order + ", on the main thread " + (where.get() == mainThread));

        try {
            Scope.call((scope) -> {
                var task = scope.fork(() -> {
                    if (zero.get() == 0) {
                        throw new IllegalStateException("the task failed");
                    }
                });
                try {
                    task.result();
                } catch (IllegalStateException e) {
                    //@ rule: concurrency.scopes.body-raised-exception
                    //@ rule: concurrency.scopes.isdone-true-once
                    Console.println("result: raises " + e.message() + ", done " + task.isDone());
                }
                for (var i = 0; i < 5000 && !scope.isCancelled(); i++) {
                    Thread.sleep(1);
                }
                //@ rule: concurrency.scopes.task-fails-cancels
                //@ rule: concurrency.cancellation.scope-cancelled-task
                Console.println("a failed task cancels its scope: " + scope.isCancelled());
            });
            Console.println("call: returned");
        } catch (IllegalStateException e) {
            Console.println("call: raises " + e.message());
        }

        var noticed = new AtomicInt(0);
        try {
            Scope.call((scope) -> {
                scope.fork(() -> {
                    try {
                        while (true) {
                            Thread.sleep(2);
                        }
                    } catch (CancellationException e) {
                        noticed.set(1);
                        throw e;
                    }
                });
                if (zero.get() == 0) {
                    throw new IllegalArgumentException("the body failed");
                }
            });
        } catch (IllegalArgumentException e) {
            //@ rule: concurrency.scopes.before-returns-cancels
            //@ rule: concurrency.scopes.failure-task-fails
            //@ rule: concurrency.scopes.exceptions-failed-tasks
            //@ rule: concurrency.scopes.body-call-raised
            Console.println("body: raises " + e.message() + ", its task was cancelled " + noticed.get() + ", suppressed " + e.suppressed().length());
        }

        var ready = new AtomicInt(0);
        //@ rule: concurrency.scopes.task-failed-exception
        try {
            Scope.call((scope) -> {
                scope.fork(() -> {
                    until(ready);
                    if (zero.get() == 0) {
                        throw new IllegalStateException("first in fork order");
                    }
                });
                scope.fork(() -> {
                    ready.set(1);
                    if (zero.get() == 0) {
                        throw new IllegalArgumentException("second in fork order");
                    }
                });
            });
            Console.println("failure: call returned");
        } catch (IllegalStateException e) {
            Console.println("failure: " + e.message() + ", suppressed " + e.suppressed().length() + ": " + e.suppressed()[0].message());
        }

        // ---- 13.6 ----
        var spin = new AtomicInt(0);
        var outcome = Scope.call((scope) -> {
            var task = scope.fork(() -> {
                until(spin);
                return "ran on";
            });
            scope.cancel();
            var marked = scope.isCancelled();
            spin.set(1);
            return "" + marked + " " + scope.isCancelled() + ", and the task " + task.result();
        });
        //@ rule: concurrency.cancellation.cancellation-request
        //@ rule: concurrency.cancellation.cancelled-task-goes
        //@ rule: concurrency.cancellation.cancel-marks-scope
        //@ rule: concurrency.cancellation.scope-cancelled-stays
        Console.println("cancel: " + outcome);

        var finished = Thread.start(() -> {
        });
        finished.join();
        var quiet = new Lock();
        var never = quiet.newCondition();
        //@ rule: execution.exceptions.table
        //@ rule: concurrency.cancellation.task-cancelled-scope
        //@ rule: concurrency.cancellation.call-thread-checkcancelled
        //@ rule: concurrency.cancellation.call-thread-sleep
        Console.println("points: " + point(() -> Thread.checkCancelled()) + " " + point(() -> Thread.sleep(1)) + " " + point(() -> finished.join()) + " " + point(() -> {
            var x = tasks[0].result();
        }) + " " + point(() -> {
            quiet.lock();
            try {
                never.await();
            } finally {
                quiet.unlock();
            }
        }));
        //@ rule: concurrency.cancellation.lock-not-point
        Console.println("lock is not a point: " + point(() -> {
            quiet.lock();
            quiet.unlock();
        }));
    }
}
