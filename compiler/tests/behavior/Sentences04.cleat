// Chapter 4 at run time. A line `//@ rule:` names the rule that the next statement
// shows.
package t;

class Trace {
    public static String log = "";

    @Discardable
    public static Int note(String what) {
        log = log + what + " ";
        return 1;
    }

    public static Boolean is(String what, Boolean value) {
        log = log + what + " ";
        return value;
    }

    public static String take() {
        var all = log;
        log = "";
        return all;
    }
}

open class Shape {
    public open String name() {
        return "shape";
    }

    public open Shape copy() {
        return new Shape();
    }

    public String viaThis() {
        return name();
    }

    public static String kind() {
        return "a static method";
    }
}

class Circle extends Shape {
    @Override
    public String name() {
        return "circle";
    }

    @Override
    public Circle copy() {
        return new Circle();
    }

    public String above() {
        return super.name();
    }

    public String inherited() {
        return viaThis() + " " + kind();
    }
}

class Target {
    public Int count = 0;

    public Int take(Int a, Int b) {
        Trace.note("body");
        return a + b;
    }

    public static Target made(String label) {
        Trace.note(label);
        return new Target();
    }

    public static String who() {
        return "static";
    }

    public String who(Int n) {
        return "instance";
    }
}

open class BaseOver {
    public String m(Object o) {
        return "inherited";
    }
}

class SubOver extends BaseOver {
    public String m(String s) {
        return "own";
    }
}

class Over {
    public static String pick() {
        return "none";
    }

    public static String pick(Int n) {
        return "number";
    }

    public static String pick(String s) {
        return "text";
    }

    public static String pick(Int a, Int b) {
        return "two";
    }

    public static String shape(Object o) {
        return "object";
    }

    public static String shape(Shape s) {
        return "shape";
    }

    public static String shape(Circle c) {
        return "circle";
    }

    public static String rest(Int a) {
        return "fixed";
    }

    public static String rest(Int... all) {
        return "varargs-" + all.length();
    }

    public static String wide(Int n) {
        return "Int";
    }

    public static String wide(String s) {
        return "String";
    }

    public static String closer(Int16 n) {
        return "Int16";
    }

    public static String closer(Int n) {
        return "Int";
    }

    public static String call(Function0<Int> f) {
        return "none";
    }

    public static String call(Function1<Int, Int> f) {
        return "an-Int";
    }

    public static String call(Function1<String, Int> f) {
        return "a-String";
    }

    public static Int[] all(Int... values) {
        return values;
    }
}

value class Meters {
    public Int length;

    @Implicit
    public static Meters from(Int whole) {
        Trace.note("from(" + whole + ")");
        return new Meters(whole);
    }
}

// Every operator spelling, on a class of the program.
class Op {
    public String plus(Op o) {
        return "plus";
    }

    public String minus(Op o) {
        return "minus";
    }

    public String times(Op o) {
        return "times";
    }

    public String div(Op o) {
        return "div";
    }

    public String mod(Op o) {
        return "mod";
    }

    public String negate() {
        return "negate";
    }

    public String lessThan(Op o) {
        return "lessThan";
    }

    public String atMost(Op o) {
        return "atMost";
    }

    public String greaterThan(Op o) {
        return "greaterThan";
    }

    public String atLeast(Op o) {
        return "atLeast";
    }

    public String and(Op o) {
        return "and";
    }

    public String or(Op o) {
        return "or";
    }

    public String xor(Op o) {
        return "xor";
    }

    public String complement() {
        return "complement";
    }

    public String shiftLeft(Int n) {
        return "shiftLeft";
    }

    public String shiftRight(Int n) {
        return "shiftRight";
    }

    public String not() {
        return "not";
    }

    public String get(Int i) {
        return "get";
    }

    public void set(Int i, String e) {
        Trace.note("set");
    }
}

class Loud {
    @Override
    public Boolean equals(Object? other) {
        Trace.note("equals");
        return other instanceof Loud;
    }

    @Override
    public Int hashCode() {
        return 1;
    }

    @Override
    public String toString() {
        return "a detail";
    }
}

value class LoudValue {
    public Int n;

    @Override
    public Boolean equals(Object? other) {
        Trace.note("equals");
        return other instanceof LoudValue;
    }

    @Override
    public Int hashCode() {
        return n;
    }
}

class Grid {
    public Int last = 0;

    public Int get(Int i) {
        return last;
    }

    public void set(Int i, Int e) {
        Trace.note("set");
        last = e;
    }

    public static Grid made() {
        Trace.note("grid");
        return new Grid();
    }
}

class Made {
    public final String how;

    public Made() {
        this.how = "none";
    }

    public Made(Int n) {
        this.how = "number";
    }

    public Made(String s) {
        this.how = "text";
    }
}

class Box {
    public final Int value;

    public Box(Int value) {
        this.value = value;
    }

    public Int get() {
        return value;
    }

    public static Box made(Int value) {
        Trace.note("made");
        return new Box(value);
    }
}

class Counter {
    public Int count = 0;

    public Function0<Int> bump() {
        return () -> {
            this.count = this.count + 1;
            return count;
        };
    }

    public static Function1<Int, Int> adder(Int base) {
        return (n) -> n + base;
    }
}

class Walk implements Iterable<Int>, Iterator<Int> {
    Int at = 0;

    @Override
    public Iterator<Int> iterator() {
        Trace.note("iterator");
        return this;
    }

    @Override
    public Boolean hasNext() {
        Trace.note("hasNext");
        return at < 2;
    }

    @Override
    public Int next() {
        Trace.note("next");
        at = at + 1;
        return at;
    }
}

enum Light { RED, AMBER, GREEN }

sealed interface Expr permits Num, Neg {
}

value class Num implements Expr {
    public Int value;
}

value class Neg implements Expr {
    public Expr operand;
}

value class Division {
    public Int32 quot;
    public Int32 rem;

    public Division {
        Trace.note("d" + quot);
        if (rem < 0) {
            throw new IllegalArgumentException("a negative remainder");
        }
    }
}

value class Raw {
    public Int32 quot;
    public Int32 rem;
}

value class Halves {
    public Division first;
    public Division second;

    Halves {
        Trace.note("halves");
    }
}

value class RawHalves {
    public Raw first;
    public Raw second;
}

public class Sentences04 {
    static Int zero = 0;

    foreign static Int32 abs(Int32 n);

    @Symbol("llabs")
    foreign static Int magnitude(Int n);

    foreign static UInt64 strlen(UInt8[] text);

    foreign static Pointer memset(UInt8[] target, Int32 value, UInt64 count);

    foreign static Division div(Int32 n, Int32 d);

    @Symbol("memcpy")
    foreign static Pointer copyDivisions(Division[] target, Raw[] source, UInt64 count);

    @Symbol("memcpy")
    foreign static Pointer copyHalves(Halves[] target, RawHalves[] source, UInt64 count);

    static Int index() {
        Trace.note("index");
        return 1;
    }

    static void change(Int n) {
        n = n + 1;
        Trace.note("parameter-" + n);
    }

    static String sign(Int n) {
        if (n > 0) {
            return "positive";
        } else {
            return "other";
        }
    }

    static String light(Light l) {
        return switch (l) {
            case Light.RED -> "stop";
            case Light.AMBER, Light.GREEN -> "go";
        };
    }

    static Int eval(Expr e) {
        return switch (e) {
            case Num n -> n.value;
            case Neg n -> -eval(n.operand);
        };
    }

    static String what(Object o) {
        switch (o) {
            case String s -> {
                return "a String of " + s.length();
            }
            case Shape s -> {
                return "a " + s.name();
            }
            default -> {
                return "something else";
            }
        }
    }

    static String word(Int n) {
        var out = "";
        switch (Trace.note("selector") + n) {
            case 1, 2 -> out = "low";
            case 3 -> out = "three";
            default -> out = "high";
        }
        return out;
    }

    static void nothing() {
        Trace.note("before");
        if (zero == 0) {
            return;
        }
        Trace.note("after");
    }

    public static void main() {
        var circle = new Circle();
        Shape shape = circle;
        Object object = circle;

        // ---- 4.1, 4.2, 4.3 ----
        var target = new Target();
        //@ rule: methods.declaring.static-method-instance
        Console.println("a shared name: " + Target.who() + " " + target.who(1));
        //@ rule: methods.overriding.inside-instance-method
        //@ rule: methods.calls.chosen-method-open
        Console.println("overriding: " + shape.name() + " " + shape.copy().name() + " " + circle.above() + " " + shape.viaThis());
        //@ rule: methods.calls.receiver-this-instance
        Console.println("no receiver written: " + circle.inherited());
        var sum = Target.made("receiver").take(Trace.note("first"), Trace.note("second") + 1);
        //@ rule: methods.calls.call-evaluates-receiver
        Console.println("a call: " + Trace.take() + sum);
        //@ rule: methods.calls.chooses-method-compile
        //@ rule: methods.overloading.applicable-method-more-specific-chosen
        Console.println("static types: " + Over.shape(object) + " " + Over.shape(shape) + " " + Over.shape(circle));

        // ---- 4.4 ----
        Int8 small = 5;
        //@ rule: methods.overloading.methods-class-share
        Console.println("overloads: " + Over.pick() + " " + Over.pick(1) + " " + Over.pick("s") + " " + Over.pick(1, 2));
        //@ rule: methods.overloading.call-chooses-among
        Console.println("inherited overloads: " + new SubOver().m("s") + " " + new SubOver().m(5));
        //@ rule: methods.overloading.method-fixed-number
        Console.println("fixed and varargs: " + Over.rest(1) + " " + Over.rest(1, 2) + " " + Over.rest());
        //@ rule: methods.overloading.none-considers-methods
        //@ rule: methods.overloading.second-round-class
        Console.println("the second round: " + Over.wide(small) + " " + Over.closer(small));

        // ---- 4.5 ----
        Meters height = 3;
        Meters? maybe = 4;
        var noted = Trace.take();
        //@ rule: methods.assignability.implicit-conversion-value
        //@ rule: methods.assignability.static-method-marked
        Console.println("an implicit conversion: " + noted + height + " " + maybe);

        // ---- 4.6 ----
        var a = new Op();
        var b = new Op();
        a[0] = "e";
        //@ rule: methods.operators.class-declare-methods
        Console.println("every operator: " + (a + b) + " " + (a - b) + " " + (a * b) + " " + (a / b) + " " + (a % b) + " " + -a + " " + (a < b) + " " + (a <= b) + " " + (a > b) + " " + (a >= b) + " " + (a & b) + " " + (a | b) + " " + (a ^ b) + " " + ~a + " " + (a << 1) + " " + (a >> 1) + " " + !a + " " + a[0] + " " + Trace.take());
        var loud = new Loud();
        var other = new Loud();
        var same = loud == other;
        var values = new LoudValue(1) == new LoudValue(2);
        //@ rule: methods.operators.equality-equals-reference
        Console.println("equality: " + Trace.take() + same + " " + values);
        var differs = loud != other;
        //@ rule: methods.operators.not-equals-equals
        Console.println("inequality: " + Trace.take() + differs);
        Loud? absent = null;
        var isNull = absent == null;
        Loud? here = loud;
        var notNull = here != null;
        //@ rule: methods.operators.operand-literal-null
        Console.println("a null test: [" + Trace.take() + "] " + isNull + " " + notNull);
        //@ rule: methods.operators.reference-identity-identical
        Console.println("identity: " + loud.identical(other) + " " + loud.identical(loud));
        var cells = new Int[] { 1, 2, 3 };
        cells[index()] += 5;
        Target.made("holder").count += 2;
        //@ rule: methods.operators.compound-assignment-except
        Console.println("compound assignment: " + Trace.take() + cells[1]);
        var n = 12;
        var steps = "";
        n -= 2;
        steps = steps + n + " ";
        n *= 3;
        steps = steps + n + " ";
        n %= 7;
        steps = steps + n + " ";
        n &= 3;
        steps = steps + n + " ";
        n |= 4;
        steps = steps + n + " ";
        n ^= 5;
        steps = steps + n + " ";
        n <<= 2;
        steps = steps + n + " ";
        n >>= 1;
        steps = steps + n + " ";
        Rational ratio = 3;
        ratio /= 2;
        //@ rule: methods.operators.holds
        Console.println("compound operators: " + steps + ratio);
        var i = 5;
        var post = i++;
        var pre = ++i;
        var postDown = i--;
        var preDown = --i;
        cells[index()]++;
        //@ rule: methods.operators.increment-location-evaluated
        //@ rule: methods.operators.prefix-form-yields
        Console.println("increment: " + post + " " + pre + " " + postDown + " " + preDown + " " + i + " | " + Trace.take() + cells[1]);
        Float64 f = 1.5;
        f++;
        Rational half = 0.5;
        half--;
        small++;
        //@ rule: methods.operators.literal-takes-class
        Console.println("the literal's class: " + f + " " + half + " " + small);
        Int8 top = 127;
        var raised = "returns";
        try {
            top++;
        } catch (ArithmeticException e) {
            raised = "raises";
        }
        //@ rule: methods.operators.method-raises-location
        Console.println("an increment that raises: " + raised + " " + top);

        // ---- 4.7 ----
        var and1 = Trace.is("a", false) && Trace.is("b", true);
        var and2 = Trace.is("a", true) && Trace.is("b", false);
        var and3 = Trace.is("a", true) && Trace.is("b", true);
        //@ rule: methods.expressions.and-evaluates
        //@ rule: methods.expressions.false-result-not
        //@ rule: methods.expressions.otherwise-result-value
        //@ rule: methods.expressions.otherwise-result-value-2
        Console.println("and: " + Trace.take() + "| " + and1 + " " + and2 + " " + and3);
        var or1 = Trace.is("a", true) || Trace.is("b", false);
        var or2 = Trace.is("a", false) || Trace.is("b", true);
        var or3 = Trace.is("a", false) || Trace.is("b", false);
        //@ rule: methods.expressions.or-evaluates
        //@ rule: methods.expressions.true-result-not
        Console.println("or: " + Trace.take() + "| " + or1 + " " + or2 + " " + or3);
        var both1 = Trace.is("a", false) & Trace.is("b", true);
        var both2 = Trace.is("a", true) | Trace.is("b", false);
        //@ rule: methods.expressions.boolean-methods-and
        Console.println("both operands: " + Trace.take() + "| " + both1 + " " + both2);
        var chosen1 = Trace.is("c", true) ? Trace.note("a") : Trace.note("b") + 1;
        var chosen2 = Trace.is("c", false) ? Trace.note("a") : Trace.note("b") + 1;
        //@ rule: methods.expressions.conditional-type-boolean
        //@ rule: methods.expressions.exactly-evaluated-value
        Console.println("conditional: " + Trace.take() + "| " + chosen1 + " " + chosen2);
        String? missing = null;
        String? present = "left";
        //@ rule: methods.expressions.coalesce-value-unless
        Console.println("??: " + (missing ?? "right") + " " + (present ?? "right"));
        Object text = "text";
        var cast = (String) text;
        var failed = "returns";
        try {
            var number = (Int) text;
        } catch (ClassCastException e) {
            failed = "raises";
        }
        Object ints = new List<Int>();
        var generic = "accepted";
        try {
            var strings = (List<String>) ints;
        } catch (ClassCastException e) {
            generic = "refused";
        }
        //@ rule: methods.expressions.casts-evaluates-tests
        //@ rule: methods.expressions.failed-cast-raises
        //@ rule: methods.expressions.test-succeeds-class
        //@ rule: methods.expressions.successful-cast-yields
        Console.println("casts: " + cast.identical(text) + " " + cast.length() + " " + failed + " " + ((Shape) object).name() + " " + generic);
        Object? nothing = null;
        //@ rule: methods.expressions.instanceof-true-value
        Console.println("instanceof: " + (text instanceof String) + " " + (text instanceof Shape) + " " + (nothing instanceof String) + " " + (object instanceof Shape) + " " + (ints instanceof List<Int>) + " " + (ints instanceof List<String>));
        //@ rule: methods.expressions.new-args-creates
        //@ rule: methods.expressions.constructor-chosen-chooses
        Console.println("constructors: " + new Made().how + " " + new Made(1).how + " " + new Made("s").how);
        var x = 0;
        var stored = (x = 5);
        Int8 narrow = 0;
        var kept = (narrow = 7);
        var listOf = new List<Int8>();
        listOf.add(kept);
        Target.made("receiver").count = Trace.note("value");
        Grid.made()[index()] = Trace.note("element");
        //@ rule: methods.expressions.assignment-evaluates-stores
        //@ rule: methods.expressions.evaluates-stores-field
        //@ rule: methods.expressions.evaluates-order-calls
        //@ rule: methods.expressions.assignment-expression-value
        Console.println("assignment: " + x + " " + stored + " " + kept + " " + listOf.getClass().getName() + " | " + Trace.take());

        // ---- 4.8 ----
        Function1<Int, Int> twice = (k) -> k * 2;
        Object asObject = twice;
        Function2<Int, Int, Int> add = (p, q) -> {
            return p + q;
        };
        Function0<String> word = () -> "word";
        //@ rule: methods.lambdas.stands-expected-type
        Console.println("a lambda: " + twice.invoke(3) + " " + add.invoke(2, 3) + " " + word.invoke() + " " + (asObject instanceof Function1<Int, Int>));
        Function1<Int, String> early = (k) -> {
            if (k > 0) {
                return "positive";
            }
            return "other";
        };
        var afterReturn = early.invoke(1) + " " + early.invoke(-1);
        //@ rule: methods.lambdas.return-inside-lambda
        Console.println("return in a lambda: " + afterReturn + ", and the method goes on");
        var counter = new Counter();
        var bump = counter.bump();
        //@ rule: methods.lambdas.inside-lambda-this
        //@ rule: methods.lambdas.lambda-read-assign
        Console.println("this in a lambda: " + bump.invoke() + " " + bump.invoke() + " " + counter.count);
        var held = new List<Function0<Int>>();
        for (var k = 0; k < 3; k++) {
            var now = k * 10;
            held.add(() -> now);
        }
        //@ rule: methods.lambdas.lambda-holds-values
        Console.println("captured values: " + held[0].invoke() + " " + held[1].invoke() + " " + held[2].invoke());
        //@ rule: methods.lambdas.instance-belongs-final
        //@ rule: methods.lambdas.fields-captured-values
        Console.println("the instance: " + Counter.adder(1).equals(Counter.adder(1)) + " " + Counter.adder(1).equals(Counter.adder(2)) + " " + (Counter.adder(1).hashCode() == Counter.adder(1).hashCode()));
        var seen = new List<Int>();
        Function1<Int, Unit> keep = (k) -> seen.add(k);
        Function0<Unit> count = () -> counter.count++;
        keep.invoke(4);
        count.invoke();
        //@ rule: methods.lambdas.result-type-unit
        Console.println("a Unit result: " + seen.size() + " " + counter.count);
        //@ rule: methods.lambdas.overload-resolution-lambda
        Console.println("lambdas in overloads: " + Over.call(() -> 1) + " " + Over.call((Int k) -> k) + " " + Over.call((String s) -> s.length()));
        Function1<Int, String> ofStatic = Sentences04::sign;
        Function1<String, Int> ofInstance = String::length;
        Function2<String, String, Boolean> withArgument = String::startsWith;
        Function0<Int> ofValue = Box.made(2)::get;
        var twiceRead = ofValue.invoke() + ofValue.invoke();
        var evaluated = Trace.take();
        Function1<Int, Box> ofNew = Box::new;
        Function1<Int, String> byInt = Over::pick;
        Function1<String, String> byString = Over::pick;
        //@ rule: methods.lambdas.method-references-reference
        //@ rule: methods.lambdas.type-reference-name-static
        //@ rule: methods.lambdas.type-reference-name-instance
        //@ rule: methods.lambdas.expr-reference-name
        //@ rule: methods.lambdas.type-reference-new
        //@ rule: methods.lambdas.parameter-types-interface
        Console.println("method references: " + ofStatic.invoke(5) + " | " + ofInstance.invoke("abc") + " " + withArgument.invoke("hello", "he") + " | " + evaluated + twiceRead + " | " + ofNew.invoke(7).value + " | " + byInt.invoke(1) + " " + byString.invoke("s"));

        // ---- 4.9 ----
        Int declared;
        declared = 2;
        final Int fixed = 3;
        var inferred = declared + fixed;
        //@ rule: methods.statements.local-declarations-name
        Console.println("locals: " + declared + " " + fixed + " " + inferred);
        var branches = "";
        if (zero == 0) {
            branches = branches + "then ";
        } else {
            branches = branches + "else ";
        }
        if (zero != 0) {
            branches = branches + "then ";
        } else {
            branches = branches + "else ";
        }
        if (zero != 0) {
            branches = branches + "never ";
        }
        //@ rule: methods.statements.if-while-else
        //@ rule: methods.statements.without-else-nothing
        Console.println("if: " + branches);
        var w = 0;
        var turns = "";
        while (Trace.is("c", w < 2)) {
            turns = turns + w + " ";
            w++;
        }
        //@ rule: methods.statements.while-evaluates-before
        Console.println("while: " + Trace.take() + "| " + turns);
        for (var k = Trace.note("init"); Trace.is("c", k < 3); k += Trace.note("update")) {
            Trace.note("s");
        }
        //@ rule: methods.statements.for-init-update
        //@ rule: methods.statements.before-iteration-evaluates
        //@ rule: methods.statements.runs-update
        Console.println("for: " + Trace.take());
        var endless = 0;
        for (;; endless++) {
            if (endless == 3) {
                break;
            }
        }
        var updates = 0;
        for (var k = 0; k < 4; updates += Trace.note("update"), k++) {
            if (k == 1) {
                continue;
            }
            if (k == 3) {
                break;
            }
        }
        //@ rule: methods.statements.missing-true
        //@ rule: methods.statements.update-runs-after
        Console.println("for without a condition: " + endless + ", and after continue: " + Trace.take() + updates);
        var walked = "";
        for (Int step : new Walk()) {
            Trace.note("body");
            walked = walked + step;
        }
        //@ rule: methods.statements.evaluates-calls-iterator
        //@ rule: methods.statements.while-hasnext-true
        Console.println("for over a collection: " + Trace.take() + "| " + walked);
        var total = 0;
        for (var item : new Int[] { 1, 2, 3 }) {
            total += item;
        }
        //@ rule: methods.statements.var-written
        Console.println("for with var: " + total);
        //@ rule: methods.statements.switch-selector-arms
        //@ rule: methods.statements.case-c1-c2
        //@ rule: methods.statements.default-arrow-body
        Console.println("switch: " + word(0) + " " + word(1) + " " + word(2) + " " + word(9) + " | " + Trace.take());
        var selectors = "";
        switch ('b') {
            case 'a' -> selectors = selectors + "a ";
            case 'b' -> selectors = selectors + "b ";
            default -> selectors = selectors + "other ";
        }
        switch (zero == 0) {
            case true -> selectors = selectors + "true ";
            case false -> selectors = selectors + "false ";
        }
        switch ("two") {
            case "one" -> selectors = selectors + "1 ";
            case "two" -> selectors = selectors + "2 ";
            default -> selectors = selectors + "other ";
        }
        switch (Light.AMBER) {
            case Light.RED -> selectors = selectors + "red ";
            case Light.AMBER -> selectors = selectors + "amber ";
            case Light.GREEN -> selectors = selectors + "green ";
        }
        switch (zero + 7) {
            case 1 -> selectors = selectors + "one ";
        }
        //@ rule: methods.statements.no-arm-continues
        //@ rule: methods.statements.no-arm-matches
        Console.println("selectors: " + selectors + "and no arm matched");
        //@ rule: methods.statements.case-name-arrow
        Console.println("type arms: " + what("text") + ", " + what(circle) + ", " + what(5));
        Console.println("switch expressions: " + light(Light.RED) + " " + light(Light.GREEN) + " " + eval(new Neg(new Num(4))) + " " + eval(new Num(3)));
        var loops = "";
        for (var k = 0; k < 3; k++) {
            for (var j = 0; j < 3; j++) {
                if (j == 1) {
                    break;
                }
                loops = loops + k + j + " ";
            }
        }
        var odd = "";
        for (var k = 0; k < 5; k++) {
            if (k % 2 == 0) {
                continue;
            }
            odd = odd + k + " ";
        }
        //@ rule: methods.statements.labels-break-continue
        //@ rule: methods.statements.continue-starts-next
        Console.println("break and continue: " + loops + "| " + odd);
        var labelled = "";
        outer: for (var k = 0; k < 3; k++) {
            for (var j = 0; j < 3; j++) {
                if (j == 2) {
                    continue outer;
                }
                if (k == 2) {
                    break outer;
                }
                labelled = labelled + k + j + " ";
            }
        }
        block: {
            labelled = labelled + "in ";
            if (zero == 0) {
                break block;
            }
            labelled = labelled + "never ";
        }
        //@ rule: methods.statements.labeled-statement-label
        Console.println("labels: " + labelled + "out");
        nothing();
        //@ rule: methods.statements.return-returns-method
        Console.println("return: " + Trace.take() + sign(1) + " " + sign(-1));
        var thrown = "";
        try {
            throw new IllegalStateException("thrown");
        } catch (IllegalStateException e) {
            thrown = e.message();
        }
        //@ rule: methods.statements.throw-raises-value
        Console.println("throw: " + thrown);
        var asserted = "";
        try {
            assert zero == 0;
            asserted = asserted + "passes ";
            assert zero == 1;
        } catch (AssertionException e) {
            asserted = asserted + "raises [" + e.message() + "] ";
        }
        try {
            assert zero == 1 : loud;
        } catch (AssertionException e) {
            asserted = asserted + "[" + e.message() + "]";
        }
        //@ rule: methods.statements.assert-evaluates-type
        //@ rule: methods.statements.assert-detail-evaluates
        //@ rule: methods.statements.assertions-always-checked
        Console.println("assert: " + asserted);

        // ---- 4.10 ----
        var passed = new Int[] { 4, 5 };
        var listed = Over.all(Trace.note("one"), Trace.note("two") + 1, Trace.note("three") + 2);
        //@ rule: methods.varargs.call-chooses-varargs
        //@ rule: methods.varargs.otherwise-trailing-arguments
        //@ rule: methods.varargs.no-trailing-arguments
        Console.println("varargs: " + Trace.take() + listed.length() + " " + listed[2] + " " + Over.all(passed).identical(passed) + " " + Over.all().length());

        // ---- 4.11 ----
        UInt8[] bytes = new UInt8[] { 104, 105, 0, 33 };
        UInt8[] buffer = new UInt8[4];
        Pointer where = memset(buffer, 7, 3);
        //@ rule: methods.foreign.body-function
        //@ rule: methods.foreign.function-receives-pointer
        //@ rule: methods.foreign.length-not-passed
        //@ rule: methods.foreign.writes-array-call
        //@ rule: methods.foreign.equals-compares-addresses
        //@ rule: methods.foreign.symbol-method-name
        Console.println("foreign: " + abs(-5) + " " + magnitude(-9000000000) + " " + strlen(bytes) + " " + buffer[0] + buffer[2] + buffer[3] + " " + (where == Pointer.zero()) + " " + (Pointer.zero() == Pointer.zero()));
        var whole = div(7, 2);
        var returned = "" + whole.quot + "r" + whole.rem + " " + Trace.take();
        try {
            returned = returned + div(-7, 2).quot;
        } catch (IllegalArgumentException e) {
            returned = returned + Trace.take() + e.message();
        }
        //@ rule: methods.foreign.value-class-returns
        //@ rule: methods.foreign.exception-constructor-raises
        Console.println("a value C returns: " + returned);
        Division[] into = new Division[3];
        var written = Trace.take();
        Raw[] from = new Raw[] { new Raw(1, 1), new Raw(2, -1), new Raw(3, 3) };
        try {
            Pointer copied = copyDivisions(into, from, 24);
        } catch (IllegalArgumentException e) {
            written = written + e.message() + " " + Trace.take();
        }
        //@ rule: methods.foreign.element-takes-place
        //@ rule: execution.values.besides-new-things
        Console.println("an array C writes: " + written + into[0].quot + into[1].quot + into[2].quot);
        Halves[] pairs = new Halves[2];
        var built = Trace.take();
        RawHalves[] raw = new RawHalves[] { new RawHalves(new Raw(1, 0), new Raw(2, 0)), new RawHalves(new Raw(3, 0), new Raw(4, 0)) };
        Pointer moved = copyHalves(pairs, raw, 32);
        //@ rule: execution.values.value-class-produced
        //@ rule: execution.values.field-holds-value
        Console.println("inner values first: " + built + "| " + Trace.take() + pairs[1].second.quot);
    }
}
