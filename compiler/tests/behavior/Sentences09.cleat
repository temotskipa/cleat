// Chapter 9 at run time. A line `//@ rule:` names the rule that the next statement
// shows.
package t;

@Target(Site.FIELD)
annotation Mark;

class Marked {
    @Mark
    Int hidden = 1;

    @Mark
    public final Int fixed = 2;
}

class Trace {
    public static String log = "";

    @Discardable
    public static Int note(String what) {
        log = log + what + " ";
        return 1;
    }

    public static String take() {
        var all = log;
        log = "";
        return all;
    }

    public static void clear() {
        log = "";
    }

    public static Int fail(String what) {
        throw new IllegalStateException(what);
    }
}

class Receiver {
    public Int take(Int a, Int b) {
        Trace.note("method");
        return a + b;
    }

    public static Receiver made() {
        Trace.note("receiver");
        return new Receiver();
    }
}

class MyError extends Throwable {
    public MyError() {
        super();
    }

    public MyError(String message) {
        super(message);
    }

    public MyError(String message, Throwable cause) {
        super(message, cause);
    }
}

class Resource {
    final String name;
    final Boolean failsOnClose;

    public Resource(String name, Boolean failsOnClose) {
        this.name = name;
        this.failsOnClose = failsOnClose;
        super();
        Trace.note("open-" + name);
    }

    public void close() {
        Trace.note("close-" + name);
        if (failsOnClose) {
            throw new MyError("close of " + name);
        }
    }

    public static Resource broken(String name) {
        throw new MyError("no " + name);
    }
}

open class Base {
    public Base() {
        super();
        Trace.note("Base sees " + describe());
    }

    public open String describe() {
        return "base";
    }
}

class Derived extends Base {
    final Int size;

    public Derived(Int size) {
        this.size = size;
        super();
        Trace.note("Derived done");
    }

    @Override
    public String describe() {
        return "size " + size;
    }
}

value class Vec3 {
    public Int x;
    public Int y;
    public Int z;
}

value class Range {
    public Int low;
    public Int high;

    public Range {
        if (low > high) {
            throw new IllegalArgumentException("low is above high");
        }
        Trace.note("range " + this.low + ".." + width());
    }

    public Int width() {
        return high - low;
    }
}

value class Empty {
}

class ByNew {
    static Int ready = Trace.note("ByNew");
}

class ByCall {
    static Int ready = Trace.note("ByCall");

    public static Int get() {
        return 1;
    }
}

class ByAssign {
    public static Int slot = Trace.note("ByAssign");
}

class Noted {
    public String? note;
    public Int n;

    public Noted(Int n) {
        this.n = n;
    }

    public void finalize() {
        Trace.note("finalized");
    }
}

class ByField {
    public static Int ready = Trace.note("ByField");
    public static final Int CONSTANT = 3;
}

open class Above {
    static Int ready = Trace.note("Above");
}

class Below extends Above {
    static Int first = Trace.note("first");

    static {
        Trace.note("block");
    }

    static Int second = Trace.note("second") + own();

    static Int own() {
        Trace.note("own-method");
        return 1;
    }

    public static Int get() {
        return second;
    }
}

class Slow {
    public static Int value = Slow.make();

    static Int make() {
        Sentences09.started.incrementAndGet();
        Thread.sleep(40);
        return 7;
    }
}

class Early {
    public static Int a = Early.peek();
    public static Int b = 5;

    static Int peek() {
        return b;
    }
}

class Broken {
    public static Int value = Trace.fail("the initializer failed");
}

public class Sentences09 {
    public static final AtomicInt started = new AtomicInt(0);

    static Int add(Int a, Int b) {
        Trace.note("method");
        return a + b;
    }

    static String finallyWays(Int way) {
        var count = 0;
        while (count < 2) {
            count += 1;
            try {
                if (way == 1) {
                    return "returned";
                }
                if (way == 2) {
                    break;
                }
                if (way == 3) {
                    continue;
                }
                if (way == 4) {
                    throw new MyError("raised");
                }
            } finally {
                Trace.note("finally");
            }
        }
        return "left the loop";
    }

    static Int thrower() {
        throw new MyError("from the callee");
    }

    public static void main() {
        // ---- 9.1 ----
        var sum = Trace.note("left") + Trace.note("right");
        //@ rule: execution.order.operands-evaluated-left
        Console.println("operands: " + Trace.take());
        var total = Receiver.made().take(Trace.note("first"), Trace.note("second"));
        //@ rule: execution.order.receiver-evaluated-before
        //@ rule: execution.order.argument-evaluated-before
        Console.println("call: " + Trace.take());
        try {
            var never = Trace.note("before") + Trace.fail("stop") + Trace.note("after");
        } catch (IllegalStateException e) {
            //@ rule: execution.order.evaluating-part-expression
            Console.println("raised in an expression: " + Trace.take());
        }

        // ---- 9.2 ----
        var plain = new MyError();
        var caused = new MyError("why", plain);
        //@ rule: execution.exceptions.message-given-construction
        Console.println("message: [" + caused.message() + "] [" + plain.message() + "]");
        //@ rule: execution.exceptions.cause-exception-given
        Console.println("cause: " + (caused.cause() == plain) + " " + (plain.cause() == null));
        //@ rule: execution.exceptions.default-tostring-exception
        Console.println("toString: " + plain + " | " + caused);
        try {
            for (var i = 0; i < 3; i++) {
                {
                    Trace.note("loop-" + i);
                    if (i == 1) {
                        throw new MyError("out");
                    }
                    Trace.note("after-" + i);
                }
            }
            Trace.note("after the loop");
        } catch (MyError e) {
            //@ rule: execution.exceptions.throw-raises-exception
            //@ rule: execution.exceptions.raised-exception-ends
            Console.println("propagates: " + Trace.take() + "caught " + e.message());
        }
        try {
            var x = thrower();
        } catch (MyError e) {
            //@ rule: execution.exceptions.no-statement-method
            Console.println("from a call: " + e.message());
        }

        // The table of 9.2: what raises each class.
        Object text = "text";
        try {
            var number = (Int) text;
        } catch (ClassCastException e) {
            //@ rule: execution.exceptions.table
            Console.println("a cast fails: ClassCastException");
        }
        var three = new Int[3];
        var outside = "";
        try {
            var element = three[Trace.note("index") + 2];
        } catch (IndexOutOfBoundsException e) {
            outside = outside + "index ";
        }
        try {
            var part = "abc".substring(Trace.note("from"), 9);
        } catch (IndexOutOfBoundsException e) {
            outside = outside + "range";
        }
        Trace.clear();
        //@ rule: execution.exceptions.table
        Console.println("outside its bounds: " + outside);
        try {
            assert Trace.note("assertion") == 2;
        } catch (AssertionException e) {
            //@ rule: execution.exceptions.table
            Console.println("an assertion is false: AssertionException");
        }
        Trace.clear();
        var marked = new Marked();
        var mirrors = Marked.class.<Mark>getAnnotatedFields();
        var refused = "";
        try {
            var hidden = mirrors[0].get(marked);
        } catch (IllegalAccessException e) {
            refused = refused + "not public, ";
        }
        try {
            mirrors[1].set(marked, 5);
        } catch (IllegalAccessException e) {
            refused = refused + "final";
        }
        //@ rule: execution.exceptions.table
        Console.println("a mirror is refused: " + refused);

        // ---- 9.3 ----
        try {
            Trace.note("try");
            throw new IllegalStateException("thrown");
        } catch (ArithmeticException e) {
            Trace.note("wrong clause");
        } catch (IllegalStateException e) {
            Trace.note("clause for " + e.message());
        } catch (Throwable e) {
            Trace.note("later clause");
        } finally {
            Trace.note("finally");
        }
        //@ rule: execution.try.try-block-runs
        //@ rule: execution.try.raises-exception-catch
        //@ rule: execution.try.first-clause-type
        Console.println("try: " + Trace.take());
        try {
            try {
                throw new MyError("inner");
            } catch (ArithmeticException e) {
                Trace.note("not this one");
            }
        } catch (MyError e) {
            //@ rule: execution.try.no-clause-accepts
            Console.println("no clause: goes on to the outer, " + e.message());
        }
        try {
            try {
                throw new IllegalStateException("first");
            } catch (IllegalStateException e) {
                throw new MyError("raised in a catch block");
            } catch (Throwable e) {
                Trace.note("a sibling clause");
            }
        } catch (MyError e) {
            //@ rule: execution.try.exception-raised-inside
            Console.println("in a catch block: " + e.message() + " [" + Trace.take() + "]");
        }
        //@ rule: execution.try.finally-block-runs
        Console.println("finally after return: " + finallyWays(1) + " " + Trace.take());
        Console.println("finally after break: " + finallyWays(2) + " " + Trace.take());
        Console.println("finally after continue: " + finallyWays(3) + " " + Trace.take());
        try {
            var w = finallyWays(4);
        } catch (MyError e) {
            //@ rule: execution.try.statement-completes-way
            Console.println("finally after an exception: " + e.message() + " " + Trace.take());
        }
        try {
            try {
                throw new MyError("earlier");
            } finally {
                var z = Trace.fail("from finally");
            }
        } catch (IllegalStateException e) {
            //@ rule: execution.try.finally-block-raises
            Console.println("finally raises: " + e.message() + ", suppressed " + e.suppressed().length() + ": " + e.suppressed()[0].message());
        }

        // ---- 9.4 ----
        using (Resource r = new Resource("a", false)) {
            Trace.note("block");
        }
        //@ rule: execution.using.using-name-block
        Console.println("using: " + Trace.take());
        try {
            using (Resource r = new Resource("b", true)) {
                throw new IllegalStateException("from the block");
            }
        } catch (IllegalStateException e) {
            //@ rule: execution.using.block-raised-exception
            Console.println("block and close raise: " + e.message() + ", suppressed " + e.suppressed().length() + ": " + e.suppressed()[0].message() + " [" + Trace.take() + "]");
        }
        try {
            using (Resource r = new Resource("c", true)) {
                Trace.note("block");
            }
        } catch (MyError e) {
            //@ rule: execution.using.block-completed-way
            Console.println("close raises: " + e.message() + " [" + Trace.take() + "]");
        }
        using (Resource one = new Resource("1", false), var two = new Resource("2", false)) {
            Trace.note("block");
        }
        //@ rule: execution.using.several-resources-written
        //@ rule: execution.using.evaluated-bound-order
        Console.println("two resources: " + Trace.take());
        try {
            using (Resource one = new Resource("1", false), Resource two = Resource.broken("2")) {
                Trace.note("block");
            }
        } catch (MyError e) {
            //@ rule: execution.using.initializer-raises-resources
            Console.println("an initializer raises: " + e.message() + " [" + Trace.take() + "]");
        }

        try {
            using (Resource one = new Resource("p", true), Resource two = new Resource("q", true)) {
                throw new IllegalStateException("from the block");
            }
        } catch (IllegalStateException e) {
            var held = e.suppressed();
            //@ rule: execution.exceptions.suppressed-returns-new
            Console.println("suppressed: " + held.length() + " in order, " + held[0].message() + " and " + held[1].message() + ", and a new array " + !held.identical(e.suppressed()));
        }
        Trace.clear();

        // ---- 9.5 ----
        var d = new Derived(5);
        //@ rule: execution.objects.calls-super-args
        //@ rule: execution.objects.after-call-super
        //@ rule: execution.objects.subclass-assigns-fields
        Console.println("construction: " + Trace.take());

        var noted = new Noted(7);
        //@ rule: execution.objects.nullable-field-exception
        Console.println("a nullable field: " + (noted.note == null));

        // ---- 9.6 ----
        var v = new Vec3(Trace.note("x"), Trace.note("y") + 1, Trace.note("z") + 2);
        //@ rule: execution.values.new-vec3-evaluates
        Console.println("value constructor: " + Trace.take() + v);
        //@ rule: execution.values.evaluations-new-value
        Console.println("equal arguments: " + new Vec3(1, 2, 3).equals(new Vec3(1, 2, 3)) + " " + (new Vec3(1, 2, 3) == v) + " " + new Vec3(1, 2, 4).equals(v));
        Trace.clear();
        var range = new Range(2, 9);
        //@ rule: execution.values.body-runs-after
        Console.println("compact form: " + Trace.take());
        try {
            var bad = new Range(9, 2);
        } catch (IllegalArgumentException e) {
            //@ rule: execution.values.body-use-this
            Console.println("compact form raises: " + e.message());
        }
        //@ rule: execution.values.value-class-no
        Console.println("no fields: " + new Empty().identical(new Empty()) + " " + new Unit().identical(new Unit()));

        // ---- 9.7 ----
        var constant = ByField.CONSTANT;
        //@ rule: execution.initialization.read-assignment-static
        Console.println("before any use: [" + Trace.take() + "]");
        var made = new ByNew();
        var called = ByCall.get();
        var read = ByField.ready;
        var again = new ByNew();
        ByAssign.slot = 4;
        var calledAgain = ByCall.get() + ByField.ready + ByAssign.slot;
        //@ rule: execution.initialization.static-state-class
        //@ rule: execution.initialization.new-class
        //@ rule: execution.initialization.call-static-methods
        Console.println("first uses: " + Trace.take());
        var below = Below.get();
        //@ rule: execution.initialization.initialization-runs-static
        //@ rule: execution.initialization.superclass-initialized-before
        //@ rule: execution.initialization.while-class-initialized
        Console.println("order: " + Trace.take());

        var seenA = new AtomicInt(0);
        var seenB = new AtomicInt(0);
        var a = Thread.start(() -> {
            seenA.set(Slow.value);
        });
        var b = Thread.start(() -> {
            seenB.set(Slow.value);
        });
        a.join();
        b.join();
        //@ rule: execution.initialization.threads-use-class
        Console.println("two threads: " + started.get() + " " + seenA.get() + " " + seenB.get());

        //@ rule: execution.exceptions.table
        //@ rule: execution.initialization.read-static-field
        try {
            var early = Early.a;
            Console.println("read too early: " + early);
        } catch (ClassInitializationException e) {
            Console.println("read too early: raises");
        }
        try {
            var broken = Broken.value;
        } catch (IllegalStateException e) {
            //@ rule: execution.initialization.exception-raised-during
            Console.println("failed initialization: " + e.message());
        }
        try {
            var broken = Broken.value;
        } catch (ClassInitializationException e) {
            Throwable? cause = e.cause();
            //@ rule: execution.initialization.later-use-failed
            Console.println("a failed class: " + (cause == null ? "no cause" : cause.message()));
        }

        // ---- 9.8 ----
        var dropped = 0;
        for (var i = 0; i < 3000; i++) {
            var gone = new Noted(i);
            dropped += gone.n - i + 1;
        }
        //@ rule: execution.storage.object-exists-creation
        //@ rule: execution.storage.reclaiming-not-observable
        Console.println("storage: kept " + noted.n + " through " + dropped + " objects that were dropped, and no finalizer ran [" + Trace.take() + "]");

        // ---- 9.10 ----
        try {
            Process.exit(256);
        } catch (IllegalArgumentException e) {
            //@ rule: execution.startup.status-outside-through
            Console.println("exit status: 256 raises");
        }
    }
}
